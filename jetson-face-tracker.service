[Unit]
Description=Jetson Face Tracker Active Vision Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/jetson/Jetson-Face-Tracker
ExecStart=/usr/bin/python3 /home/jetson/Jetson-Face-Tracker/run.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
